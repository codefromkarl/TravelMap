/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(self), geolocation=(self), payment=()
  X-XSS-Protection: 1; mode=block
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.sheetjs.com 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.amap.com https://*.is.autonavi.com https://*.tile.openstreetmap.org https://server.arcgisonline.com https://*.tile.opentopomap.org https://avatars.githubusercontent.com https://lh3.googleusercontent.com; connect-src 'self' https://restapi.amap.com https://*.amap.com https://nominatim.openstreetmap.org https://api.open-meteo.com data:; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'

/*.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# 内容哈希资源（index.html 部署时重写为 .<hash>.js/.css）：不可变长缓存
# 应用模块已打包进 app.bundle.<hash>.js，modules/ 下无未哈希的运行时引用
/modules/*.js
  Cache-Control: public, max-age=31536000, immutable

/styles/*.css
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/pi-bundle.*
  Cache-Control: public, max-age=31536000, immutable

/app.bundle.*
  Cache-Control: public, max-age=31536000, immutable

/pi-web-ui.*
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

# Service Worker 必须实时更新
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/manifest.json
  Cache-Control: public, max-age=86400

/llms.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8
  X-Robots-Tag: index

/robots.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8
