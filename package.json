{
  "name": "travel-agent",
  "version": "0.1.0",
  "description": "AI Travel Planning Agent based on pi framework",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "check": "biome check --write . && tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts src/__tests__/unit",
    "test:integration": "vitest run --config vitest.config.ts src/__tests__/integration",
    "test:eval": "vitest run --config vitest.config.ts src/__tests__/evaluation",
    "test:quality": "vitest run --config vitest.config.ts src/__tests__/quality",
    "test:qa": "bash scripts/test-qa-check.sh",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:ui": "playwright test --config playwright.config.ts --ui",
    "test:all": "vitest run --config vitest.config.ts && playwright test --config playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "deploy": "bash scripts/deploy.sh",
    "deploy:preview": "bash scripts/deploy.sh preview",
    "prepare": "husky"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "file:../pi/packages/agent",
    "@earendil-works/pi-ai": "file:../pi/packages/ai",
    "@earendil-works/pi-web-ui": "file:../pi/packages/web-ui",
    "lru-cache": "^11.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.5",
    "@playwright/test": "^1.52.0",
    "@types/yauzl": "^2.10.3",
    "@vitest/coverage-v8": "^3.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "msw": "^2.14.6",
    "node-stdlib-browser": "^1.3.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
