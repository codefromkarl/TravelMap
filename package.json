{
  "name": "travel-agent",
  "version": "0.1.0",
  "description": "AI Travel Planning Agent based on pi framework",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "check": "biome check --write . && tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.75.1",
    "@earendil-works/pi-ai": "^0.75.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.5",
    "@types/yauzl": "^2.10.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
