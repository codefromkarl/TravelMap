# ═══════════════════════════════════════════════════════════
# 小红书 API — 统一路由配置
# ═══════════════════════════════════════════════════════════
#
# 路由策略:
#   priority — 按优先级依次尝试，首个成功即返回（默认）
#   cost     — 按成本排序（免费 → 便宜 → 贵）
#   all      — 并行调用所有可用 provider，合并去重
XHS_ROUTER_STRATEGY=priority

# Provider 优先级（逗号分隔，覆盖默认顺序）:
# XHS_ROUTER_PROVIDERS=rnote,justoneapi,tikhub,crawler

# ─── Rnote（小红书专精，$0.008/次）─────────────────────────
# 注册: https://rnote.dev
XHS_RNOTE_TOKEN=
# XHS_RNOTE_BASE=https://rnote.dev

# ─── JustOneAPI（多平台聚合，注册送免费次数）─────────────────
# 注册: https://dashboard.justoneapi.com
XHS_JUSTONEAPI_TOKEN=
# XHS_JUSTONEAPI_BASE=https://api.justoneapi.com

# ─── TikHub（多平台，每日签到获免费额度）────────────────────
# 注册: https://tikhub.io
XHS_TIKHUB_TOKEN=
# XHS_TIKHUB_BASE=https://api.tikhub.io

# ─── Crawler 自部署（NanmiCoder/MediaCrawler，完全免费）──────
# 部署: https://github.com/NanmiCoder/MediaCrawler
# 启动后设置服务地址
XHS_CRAWLER_BASE=http://localhost:8080
# XHS_CRAWLER_TOKEN=

# ─── 兼容旧配置（仅影响 justoneapi）───────────────────────
# XHS_API_TOKEN=
# XHS_API_PROVIDER=justoneapi
# XHS_API_BASE=

# ═══════════════════════════════════════════════════════════
# 其他 API Keys
# ═══════════════════════════════════════════════════════════

# Google Maps API
GOOGLE_MAPS_API_KEY=

# 高德地图 API
AMAP_WEB_KEY=

# 天气 API
OPENWEATHER_API_KEY=
